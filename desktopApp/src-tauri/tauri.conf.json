{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncSwift",
  "version": "2.0.0",
  "identifier": "net.syncswift.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncSwift",
        "label": "main",
        "width": 1024,
        "height": 680,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "SyncSwift"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
