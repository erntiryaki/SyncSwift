# ==============================================================================
# SyncSwift v2 — Client Environment Configuration Template
# Copy this file to .env.local in the repository root and fill in your values.
#
# SECURITY NOTE:
# Never commit your real .env.local file to version control.
# Only public, non-secret client keys belong here.
# Administrative keys (SERVICE_ROLE_KEY, AWS Secret Keys, DB passwords)
# must ONLY be kept in infra/.env on the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Self-Hosted VPS API (Public Endpoints)
# ------------------------------------------------------------------------------
# Your public API endpoint pointing to the Kong API Gateway on the VPS
SUPABASE_URL=https://api.syncswift.net

# Public Anon Key (Signed with your VPS JWT_SECRET, enforced by Postgres RLS)
# Safe for client binaries (Android, iOS, Desktop)
SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.example_anon_key_payload...

# ------------------------------------------------------------------------------
# 2. Authentication & OAuth Providers
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (Configured in Google Cloud Console with net.syncswift)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. In-App Purchases & Subscriptions (RevenueCat Public SDK Keys)
# ------------------------------------------------------------------------------
# Google Play Public SDK Key (Android)
REVENUECAT_API_KEY=goog_your_google_play_sdk_key_here

# Apple App Store Public SDK Key (iOS)
REVENUECAT_IOS_API_KEY=appl_your_apple_storekit_sdk_key_here

# ------------------------------------------------------------------------------
# 4. Ad Monetization (Google AdMob)
# ------------------------------------------------------------------------------
# Adaptive Banner Ad Unit ID (Google sample test ad unit ID provided by default)
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111

# ------------------------------------------------------------------------------
# 5. Android Release Keystore Signing (Local Build Machine Only)
# ------------------------------------------------------------------------------
KEYSTORE_FILE=syncdrop_release.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password
